# Supabase Free Configuration (Public Frontend Keys Only)
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# SECURITY WARNING:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or any private database secret in .env or frontend code.
# All writes are protected by Supabase Auth + Postgres Row Level Security (RLS).
